{
  "name": "server-round5-smoke",
  "description": "Smoke test of the round-5 plan: limited pytest, the mux11 repro run, then 1at, 1au and 1av in miniature (configs/gomea/server-smoke5-*: 2 splits, 15 s or 400 evaluations per run). Uses its own state dir, so it never marks real steps done.",
  "state_dir": "server-run5-smoke",
  "steps": [
    {
      "id": "S0",
      "type": "check",
      "pytest": {
        "args": [
          "tests/server",
          "tests/gomea/test_const_opt.py",
          "tests/gomea/test_const_opt_guard.py",
          "tests/gomea/test_phase_report.py"
        ]
      },
      "repro": {
        "only": [
          "1ae-mux11-GOMEA-s3001"
        ]
      }
    },
    {
      "id": "smoke5-1at",
      "type": "phase",
      "phase": "server-smoke5-1at",
      "requires": [
        "datasets:WiR,Con,EnH,Air,Yac,Tow"
      ]
    },
    {
      "id": "smoke5-1au",
      "type": "phase",
      "phase": "server-smoke5-1au",
      "requires": [
        "datasets:Con,EnH,Air"
      ]
    },
    {
      "id": "smoke5-1av",
      "type": "phase",
      "phase": "server-smoke5-1av",
      "requires": [
        "datasets:Con,EnH,Air"
      ]
    }
  ]
}
