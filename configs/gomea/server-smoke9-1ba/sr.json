{
  "name": "server-smoke9-1ba-sr",
  "datasets_dir": "../gomea-results/phase1f/datasets",
  "datasets": [
    "Air",
    "Bos",
    "EnC",
    "Tow",
    "WiR",
    "WiW",
    "Yac"
  ],
  "splits": [
    1,
    2
  ],
  "wall_cap_s": 300,
  "mem_limit_mb": 5120,
  "arms": {
    "BASE": {
      "binary": ".venv/bin/moses",
      "budget": {
        "evals": 300
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "dynamic",
        "--hc-fraction-of-nn",
        "0.05",
        "--gomea-skip-inactive",
        "0",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "1",
        "--const-opt",
        "lm",
        "--const-opt-guard",
        "val",
        "--gomea-accept-complexity-ratio",
        "0.125",
        "--gomea-deme-store",
        "accepted"
      ]
    },
    "BASE-N16": {
      "binary": ".venv/bin/moses",
      "budget": {
        "evals": 300
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "1",
        "--const-opt",
        "lm",
        "--const-opt-guard",
        "val",
        "--gomea-accept-complexity-ratio",
        "0.125",
        "--gomea-deme-store",
        "accepted"
      ]
    }
  }
}
