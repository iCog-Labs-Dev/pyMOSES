{
  "name": "server-smoke17-1bk-sr",
  "datasets_dir": "../gomea-results/phase1f/datasets",
  "datasets": [
    "Air",
    "Con",
    "EnC",
    "EnH",
    "Tow",
    "Yac"
  ],
  "splits": [
    1,
    2
  ],
  "wall_cap_s": 300,
  "mem_limit_mb": 5120,
  "clip_test_nmse": true,
  "plain_nmse": true,
  "anytime": true,
  "arms": {
    "BASE-TLS": {
      "binary": ".venv/bin/moses",
      "budget": {
        "evals": 1000
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "dynamic",
        "--hc-fraction-of-nn",
        "0.05",
        "--gomea-skip-inactive",
        "0",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "terms",
        "--const-opt",
        "none",
        "--gomea-accept-complexity-ratio",
        "0.125",
        "--gomea-deme-store",
        "accepted",
        "--gomea-trace",
        "1"
      ]
    }
  }
}
