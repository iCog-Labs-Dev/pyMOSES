        "10000",
        "--generations",
        "-1"
      ]
    },
    "GPGOMEA-P16": {
      "binary": "../gomea-results/phase1b/gpgomea-build/gpgomea",
      "train": "train",
      "argv": [
        "--linearscaling",
        "--functions",
        "+_-_*_aq",
        "--erc",
        "--gomea",
        "--initmaxtreeheight",
        "4",
        "--ims",
        "4_1",
        "--popsize",
        "16",
        "--evaluations",
        "10000",
        "--generations",
        "-1"
      ]
