{
  "name": "server-smoke3-1ao-sr",
  "datasets_dir": "../gomea-results/phase1f/datasets",
  "datasets": [
    "Con",
    "EnH"
  ],
  "splits": [
    1,
    2
  ],
  "wall_cap_s": 300,
  "mem_limit_mb": 3072,
  "arms": {
    "GOMEA-LS": {
      "binary": ".venv/bin/moses",
      "budget": {
        "time_s": 20
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-max-evals-per-deme",
        "250",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "1"
      ]
    },
    "GOMEA-LS-TUNE": {
      "binary": ".venv/bin/moses",
      "budget": {
        "time_s": 20
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-max-evals-per-deme",
        "250",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "1",
        "--const-opt",
        "SET-BY-set_const_opt.py"
      ]
    },
    "HC-LS": {
      "binary": ".venv/bin/moses",
      "budget": {
        "time_s": 20
      },
      "argv": [
        "-a",
        "hc-capped",
        "--gomea-max-evals-per-deme",
        "250",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "1"
      ]
    }
  }
}
