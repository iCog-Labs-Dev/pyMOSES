  "arms": {
    "GOMEA": {
      "binary": ".venv/bin/moses",
      "budget": {
        "evals": 10000
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-max-evals-per-deme",
        "250",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced"
      ]
    },
    "GOMEA-S": {
      "binary": ".venv/bin/moses",
      "budget": {
        "evals": 10000
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-max-evals-per-deme",
        "250",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced"
      ],
      "seed": {
        "binary": "../gomea-results/gpgomea-seed-build/gpgomea-seed",
        "share": 0.2,
        "height": 3,
        "k": 5,
        "functions": "+_-_*"
      }
    },
    "GOMEA-S-RESEED": {
      "binary": ".venv/bin/moses",
      "budget": {
        "evals": 10000
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-max-evals-per-deme",
        "250",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced"
      ],
      "seed": {
        "binary": "../gomea-results/gpgomea-seed-build/gpgomea-seed",
        "share": 0.2,
        "height": 3,
        "k": 5,
        "functions": "+_-_*",
        "reseed_after": 5,
