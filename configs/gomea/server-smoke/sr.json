{
  "name": "server-smoke-sr",
  "datasets_dir": "../gomea-results/phase1f/datasets",
  "datasets": [
    "Yac"
  ],
  "splits": [
    1,
    2
  ],
  "wall_cap_s": 1800,
  "mem_limit_mb": 3072,
  "arms": {
    "GOMEA": {
      "binary": ".venv/bin/moses",
      "budget": {
        "evals": 300
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-max-evals-per-deme",
        "250",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced"
      ]
    },
    "HC": {
      "binary": ".venv/bin/moses",
      "budget": {
        "evals": 300
      },
      "argv": [
        "-a",
        "hc-capped",
        "--gomea-max-evals-per-deme",
        "250",
        "--knob-probe-baseline",
        "reduced"
      ]
    }
  }
}
