        "--gomea-skip-inactive",
        "0",
        "--gomea-max-evals-per-deme",
        "250",
        "--gomea-genotype-memo",
        "1",
        "--gomea-radii",
        "uniform",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced"
      ]
    }
  }
}
