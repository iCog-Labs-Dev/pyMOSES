{
  "name": "server-smoke5-1at-sr-ext-WiR",
  "datasets": [
    "WiR"
  ],
  "splits": [
    3,
    4
  ],
  "datasets_dir": "../gomea-results/phase1f/datasets",
  "wall_cap_s": 300,
  "mem_limit_mb": 3072,
  "arms": {
    "GOMEA-LS": {
      "binary": ".venv/bin/moses",
      "budget": {
        "time_s": 15
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-max-evals-per-deme",
        "250",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "1"
      ]
    },
    "LM": {
      "binary": ".venv/bin/moses",
      "budget": {
        "time_s": 15
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-max-evals-per-deme",
        "250",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "1",
        "--const-opt",
        "lm"
      ]
    },
    "LM-VAL": {
      "binary": ".venv/bin/moses",
      "budget": {
        "time_s": 15
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-max-evals-per-deme",
        "250",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "1",
        "--const-opt",
        "lm",
        "--const-opt-guard",
        "val"
      ]
    }
  }
}
