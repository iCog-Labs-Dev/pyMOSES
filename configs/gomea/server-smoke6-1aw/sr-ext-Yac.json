{
  "name": "server-smoke6-1aw-sr-ext-Yac",
  "datasets": [
    "Yac"
  ],
  "splits": [
    3,
    4
  ],
  "datasets_dir": "../gomea-results/phase1f/datasets",
  "wall_cap_s": 300,
  "mem_limit_mb": 3072,
  "arms": {
    "NOCAP": {
      "binary": ".venv/bin/moses",
      "budget": {
        "time_s": 15
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "1"
      ]
    },
    "LMVAL": {
      "binary": ".venv/bin/moses",
      "budget": {
        "time_s": 15
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "1",
        "--const-opt",
        "lm",
        "--const-opt-guard",
        "val"
      ]
    },
    "LMVAL-PEN125": {
      "binary": ".venv/bin/moses",
      "budget": {
        "time_s": 15
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "1",
        "--const-opt",
        "lm",
        "--const-opt-guard",
        "val",
        "--gomea-accept-complexity-ratio",
        "0.125",
        "--gomea-deme-store",
        "accepted"
      ]
    },
    "LMVAL-C250": {
      "binary": ".venv/bin/moses",
      "budget": {
        "time_s": 15
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "16",
        "--gomea-skip-inactive",
        "0",
        "--gomea-max-evals-per-deme",
        "250",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "1",
        "--const-opt",
        "lm",
        "--const-opt-guard",
        "val"
      ]
    }
  }
}
