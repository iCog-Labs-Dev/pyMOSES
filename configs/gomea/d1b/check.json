{
  "name": "d1b-check",
  "datasets_dir": ".d1work/datasets",
  "datasets": [
    "Yac"
  ],
  "splits": [
    91
  ],
  "wall_cap_s": 36000,
  "mem_limit_mb": 2048,
  "clip_test_nmse": true,
  "plain_nmse": true,
  "anytime": true,
  "arms": {
    "BASE-TLS": {
      "binary": ".venv/bin/moses",
      "budget": {
        "evals": 2000
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "dynamic",
        "--hc-fraction-of-nn",
        "0.05",
        "--gomea-skip-inactive",
        "0",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "terms",
        "--const-opt",
        "none",
        "--gomea-accept-complexity-ratio",
        "0.125",
        "--gomea-deme-store",
        "accepted",
        "--gomea-trace",
        "1",
        "--gomea-log-best-genes",
        "1"
      ]
    },
    "TLS-CW": {
      "binary": ".venv/bin/moses",
      "budget": {
        "evals": 2000
      },
      "argv": [
        "-a",
        "gomea",
        "--gomea-fos",
        "lt-b",
        "--gomea-pop-size",
        "dynamic",
        "--hc-fraction-of-nn",
        "0.05",
        "--gomea-skip-inactive",
        "0",
        "--gomea-genotype-memo",
        "1",
        "--gomea-contin",
        "copy",
        "--knob-probe-baseline",
        "reduced",
        "--linear-scaling",
        "terms",
        "--const-opt",
        "none",
        "--gomea-accept-complexity-ratio",
        "0.125",
        "--gomea-deme-store",
        "accepted",
        "--gomea-trace",
        "1",
        "--gomea-log-best-genes",
        "1",
        "--gomea-contin-start",
        "wide"
      ]
    }
  }
}
